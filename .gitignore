# Terraform working directory (provider binaries, module cache)
.terraform/
.terraform.tfstate.lock.info

# State files (may contain sensitive data; managed remotely or locally)
*.tfstate
*.tfstate.*

# Bootstrap workspace is the one exception: it provisions the remote-state
# backend itself, so its state has to live in version control.
!bootstrap/terraform.tfstate

# Crash log files
crash.log
crash.*.log

# Plan output
*.tfplan

# CLI configuration files
.terraformrc
terraform.rc

